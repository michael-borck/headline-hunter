# Copy this file to .env and fill in your key. NEVER commit the real .env.

# Required — your Anthropic API key (the only secret that matters).
ANTHROPIC_API_KEY=sk-ant-...

# Which model the hosted "Draft" button uses. Haiku is cheap + fast and plenty
# good for turning an abstract into a press-release draft. Bump to
# claude-sonnet-4-6 or claude-opus-4-8 if you want more polish (and cost).
HH_MODEL=claude-haiku-4-5

# Optional shared passcode. Leave BLANK to make the hosted service open to
# anyone who can reach it; set a value to gate it (visitors paste this into the
# "API key / access passcode" box in Settings). One word is fine.
HH_ACCESS_KEY=

# Guardrails (sane defaults; tune if needed).
HH_MAX_INPUT_CHARS=24000     # prompt cap; the Studio trims hosted papers to fit
HH_MAX_OUTPUT_TOKENS=1500    # cap the draft length
HH_RATE_LIMIT_PER_MIN=20     # per-IP requests per minute

# Port the app listens on (Caddy reverse-proxies to this).
PORT=8000
